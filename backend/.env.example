# Backend settings. Copy to .env (or set as real environment variables on the VM).
PORT=8787

# Shared secret the frontend sends as "Authorization: Bearer <key>".
# Leave empty only for local development.
ACCESS_KEY=

# Frontend origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5317

YODECK_API_TOKEN=
YODECK_BASE_URL=https://app.yodeck.com/api/v2

CAMERA_RTSP_URL=rtsp://host:8554/stream
